# Copy to docker/.env and fill in. docker-compose.yml refuses to start without the
# first four.

# Where people reach Chatly (used for invite links, cookies and push).
PUBLIC_URL=https://chat.example.com
# The public IPv4 the voice relay and TURN advertise to browsers.
VOICE_PUBLIC_IP=203.0.113.10
# TURN realm; usually the bare host name of PUBLIC_URL.
TURN_REALM=chat.example.com
# Shared by chatly and coturn. Generate with: openssl rand -hex 32
TURN_SECRET=

# Optional: run as your own user, and keep data somewhere other than ../data.
# PUID=1000
# PGID=1000
# DATA_PATH=/srv/chatly
